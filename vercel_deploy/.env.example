# คัดลอกเป็น .env แล้วใส่ค่าจริงจาก Supabase
# หรือใส่ใน Vercel → Project → Settings → Environment Variables

# ใช้ค่าใดค่าหนึ่งก็ได้ (แอปจะอ่านตามลำดับ)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# หรือชื่อที่ Vercel สร้างให้:
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# POSTGRES_URL_NON_POOLING=...

SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

PURCHASE_CURRENCY=JPY
EXCHANGE_RATE=0.25
